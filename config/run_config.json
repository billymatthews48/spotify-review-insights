{
  "schema_version": "schema-v1",
  "model_allowlist": ["jev-1.13.0", "gpt-6-luna"],
  "prompt_version": "prompts-v1",
  "enrich": {
    "provider": "typesafe",
    "model": "jev-1.13.0",
    "questions": ["topic", "intent", "severity", "sentiment"],
    "workers": 8,
    "max_requests_per_second": 50,
    "needs_review_confidence": 0.5
  },
  "quote": {
    "provider": "openai",
    "model": "gpt-6-luna",
    "reasoning_effort": "none",
    "whole_text_max_chars": 200,
    "batch_size": 50,
    "max_output_tokens": 6000,
    "workers": 2
  },
  "verify": {
    "provider": "openai",
    "model": "gpt-6-luna",
    "reasoning_effort": "none",
    "sample_fraction": 0.03,
    "min_sample": 20,
    "sample_seed": "verify-v1",
    "batch_size": 50,
    "max_output_tokens": 6000
  },
  "group": {
    "provider_discover": "openai",
    "model_discover": "gpt-6-luna",
    "reasoning_effort": "low",
    "prompt_version": "group-v2",
    "workers": 8,
    "examples_per_topic": 120,
    "provider_assign": "typesafe",
    "model_assign": "jev-1.13.0"
  },
  "memo": {
    "provider": "openai",
    "model": "gpt-6-luna",
    "reasoning_effort": "low",
    "prompt_version": "memo-v4",
    "max_output_tokens": 4000,
    "top_issues": 12,
    "examples_per_issue": 4
  },
  "limits": {
    "spend_cap_usd": 10.0,
    "max_attempts_per_batch": 2,
    "backoff_base_seconds": 1.0,
    "backoff_max_seconds": 30.0,
    "request_timeout_seconds": 60,
    "max_fallback_fraction": 0.05,
    "max_run_seconds": 21600
  }
}
